# Backend environment template.
# Copy to backend/.env for local use. Do not commit the filled file.

# dev | prod
# Local stays dev. Set prod in Render dashboard.
DJANGO_ENV=dev

# Required in prod. Use a long random value; rotate if previously committed.
SECRET_KEY=replace-with-long-random-secret-key

# Comma-separated hosts. Render also supplies RENDER_EXTERNAL_HOSTNAME.
ALLOWED_HOSTS=hris-backend.onrender.com
# RENDER_EXTERNAL_HOSTNAME=hris-backend.onrender.com

# Comma-separated Vercel origins. Add preview origins if previews call this API.
CORS_ALLOWED_ORIGINS=https://hris.vercel.app

# Public frontend URL used in account/password-setup emails.
PORTAL_URL=https://hris.vercel.app

# Neon connection string. Use the pooled URL for the app.
# Run migrations with the direct URL, not this pooled URL.
DATABASE_URL=postgresql://USER:PASSWORD@HOST-POOLER.REGION.neon.tech/DBNAME?sslmode=require

# Email. Without both user and password, Django prints emails to console.
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=replace-with-smtp-user
EMAIL_HOST_PASSWORD=replace-with-smtp-app-password
DEFAULT_FROM_EMAIL="DepEd Recruitment <noreply@example.com>"

# Required for PDS PDF extraction and AI dashboard summaries.
GEMINI_API_KEY=replace-with-gemini-api-key

# HTTPS settings. Enable only after HTTPS is confirmed.
# HSTS is hard to undo; start with 0 and raise deliberately.
SECURE_SSL_REDIRECT=False
SECURE_HSTS_SECONDS=0
SECURE_HSTS_INCLUDE_SUBDOMAINS=False
SECURE_HSTS_PRELOAD=False
